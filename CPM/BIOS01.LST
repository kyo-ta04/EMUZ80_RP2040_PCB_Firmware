                                ; bios01.asm - Z80 CBIOS for EMUZ80_RP2040_PCB
                                ;
                                ; Original: Z80 CBIOS for Z80-Simulator (z80pack)
                                ;           Copyright (C) 1988-2007 by Udo Munk
                                ; Modified: 2026 by DragonBallEZ (kyo-ta04)
                                ;
