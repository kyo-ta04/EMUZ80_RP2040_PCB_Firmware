; PIO - Z80 Bus Interface for RP2040

.program trg_rw
; RD/WRの立ち下がりを検出し、IRQ(0)を発生させる
.wrap_target
    wait 0 pin 0
    irq 0
    wait 1 pin 0
.wrap

.program m_emu
; バス監視とデータ送受信
    mov isr, null     ; ISRクリア
.wrap_target
    wait 1 irq 0
    in pins, 30       ; 30ビット取り込み(auto push)
.wrap

.program data_out
; データ送信
.wrap_target
    out pins, 8     ; auto pull
.wrap

.program d_pindirs
; RD信号に連動してデータバス(4bit)の方向を切り替える
    set pindirs, 0        ; 初期状態は入力(Hi-Z)
.wrap_target
loop:
    wait 0 pin 0          ; RD が Low になるまで待つ
    set pindirs, 0xF      ; 出力に切り替え (注: set で指定できるのは5bitまで)
    wait 1 pin 0          ; RD が High に戻るのを待つ
    set pindirs, 0        ; 入力に戻す
.wrap
